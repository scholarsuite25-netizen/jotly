# =============================================================================
# NEXUS MEETING INTELLIGENCE — ENVIRONMENT TEMPLATE (.env.example)
# Copy to .env for local development. NEVER commit real secrets or tokens.
# =============================================================================

# --- Application & Topology ---
NEXUS_ENV=development
NEXUS_APP_NAME="NEXUS Meeting Intelligence"
NEXUS_API_PREFIX=/api/v1
# Vercel Frontend Origin(s) allowed by CORS / Cloudflare Edge
NEXUS_ALLOWED_ORIGINS=http://localhost:3000,https://nexus-meeting.vercel.app
# Feature Gate: MUST remain false until Phase 6 governance gates are signed off
VOICE_CLONING_ENABLED=false

# --- Database (PostgreSQL 16 / Supabase PostgreSQL with RLS) ---
DATABASE_URL=postgresql+psycopg://nexus_app:replace_with_strong_password@localhost:5432/nexus_meeting
DATABASE_ADMIN_URL=postgresql+psycopg://nexus_admin:replace_with_strong_password@localhost:5432/nexus_meeting
DB_ECHO=false

# --- Authentication (Supabase Auth / OIDC JWT) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_JWT_SECRET=replace_with_supabase_jwt_secret_minimum_32_chars
SUPABASE_JWT_AUDIENCE=authenticated
REQUIRE_ADMIN_MFA=false

# --- Transactional Email Providers (Resend, Emailbump, Unipost) ---
EMAIL_PRIMARY_PROVIDER=resend
EMAIL_FALLBACK_PROVIDERS=emailbump,unipost
EMAIL_FROM_ADDRESS=noreply@nexus-meeting.example.com
EMAIL_FROM_NAME="NEXUS Meeting Intelligence"
# Dry-run mode captures emails in memory/logs metadata without external network calls in dev/test
EMAIL_DRY_RUN=true

RESEND_API_KEY=re_replace_with_resend_api_key
RESEND_API_BASE_URL=https://api.resend.com

EMAILBUMP_API_KEY=eb_replace_with_emailbump_api_key
EMAILBUMP_API_BASE_URL=https://api.emailbump.com/v1

UNIPOST_API_KEY=up_replace_with_unipost_api_key
UNIPOST_API_BASE_URL=https://api.unipost.co/v1

# --- Queue & Cache (Redis on Hostinger VPS / Local) ---
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (Cloudflare R2 or Private MinIO S3-Compatible) ---
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace_with_r2_or_minio_access_key
S3_SECRET_ACCESS_KEY=replace_with_r2_or_minio_secret_key
S3_BUCKET_MEDIA=nexus-private-media
S3_BUCKET_DOCUMENTS=nexus-private-documents
S3_REGION=auto
S3_PRESIGNED_URL_TTL_SECONDS=300
UPLOAD_CHUNK_SIZE_BYTES=5242880
UPLOAD_MAX_FILE_SIZE_BYTES=2147483648

# --- Cloudflare Edge & Zero Trust Tunnel (Hostinger VPS Ingress) ---
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_zero_trust_tunnel_token
CLOUDFLARE_EDGE_SHARED_SECRET=replace_with_cloudflare_origin_verify_secret

# --- Next.js Web Client (Vercel) ---
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
